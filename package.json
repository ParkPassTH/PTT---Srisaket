{
  "name": "phakmai-voice-ics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/app.test.ts tests/ics-rules.test.ts tests/line-service.test.ts tests/gemini-service.test.ts tests/outbox-service.test.ts tests/backup-service.test.ts",
    "test:watch": "tsx --test --watch tests/app.test.ts tests/ics-rules.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke:integrations": "tsx scripts/smoke-integrations.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^160.0.0",
    "helmet": "8.3.0",
    "openai": "^4.77.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "playwright-core": "^1.55.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
