NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATA_DRIVER=memory
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-deploy
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Planned alternative; requires Gemini provider adapter before use
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_TRACE_ENABLED=true
