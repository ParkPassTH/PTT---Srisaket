{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api?__path=/health" },
    { "source": "/webhooks/:path*", "destination": "/api?__path=/webhooks/:path*" },
    { "source": "/api/:path*", "destination": "/api?__path=/api/:path*" },
    { "source": "/", "destination": "/index.html" }
  ]
}
